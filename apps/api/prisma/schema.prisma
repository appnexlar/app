// ---------------------------------------------------------------------------
// broker — corretor e conta de autenticação
// ---------------------------------------------------------------------------
/// Selo de corretor verificado. Enviar o CRECI é opcional: quem não envia usa
/// o sistema inteiro do mesmo jeito, só não ganha o selo que a lead vê na
/// página pública do imóvel. É prêmio, não pedágio.
enum BrokerCreciStatus {
  nao_enviado
  pendente
  aprovado
  recusado
}

/// Conta ativa entra normalmente. Conta suspensa continua existindo, com os
/// dados intactos, mas não entra: é o oposto de excluir.
/// Qualquer status diferente de ativo barra a entrada, com a MESMA mensagem
/// externa: o motivo da porta fechada é registro interno. A diferença vive no
/// Admin: suspenso é ação administrativa reversível, bloqueado é segurança ou
/// política, desativado é conta encerrada. "Pendente de verificação" não é
/// status: deriva de email_verified_at nulo (docs/10, D3).
enum BrokerStatus {
  ativo
  suspenso
  bloqueado
  desativado
}

model Broker {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Nulo em conta criada pelo Google: não existe senha para guardar. Quem
  /// entra por senha precisa checar isso antes de comparar o hash, senão a
  /// conta social viraria uma conta sem credencial nenhuma.
  passwordHash         String?           @map("password_hash")
  /// Identificador da conta Google (claim `sub` do id_token). É estável e não
  /// muda quando a pessoa troca o e-mail no Google, por isso o vínculo mora
  /// aqui e não no endereço.
  googleId             String?           @unique @map("google_id")
  fullName             String            @map("full_name")
  email                String            @unique
  phone                String?
  creci                String?
  creciUf              String?           @map("creci_uf")
  creciStatus          BrokerCreciStatus @default(nao_enviado) @map("creci_status")
  /// Chave do documento no bucket privado. Nunca vira URL pública: quem serve
  /// é a API, e só para o dono ou para a conferência manual.
  creciDocumentKey     String?           @map("creci_document_key")
  creciSubmittedAt     DateTime?         @map("creci_submitted_at") @db.Timestamptz(6)
  creciReviewedAt      DateTime?         @map("creci_reviewed_at") @db.Timestamptz(6)
  /// Motivo da recusa, mostrado ao corretor para ele saber o que corrigir.
  creciRejectionReason String?           @map("creci_rejection_reason")
  agencyName           String?           @map("agency_name")
  avatarUrl            String?           @map("avatar_url")
  /// Foto de perfil enviada pelo corretor, no bucket privado (mesmo molde do
  /// documento de CRECI). Quando existe, vence o avatar_url externo.
  avatarKey            String?           @map("avatar_key")
  /// Nulo enquanto o corretor não clicar no link do e-mail de confirmação.
  /// É a fonte da verdade do gate: antes disso o flag morava no navegador,
  /// onde qualquer um podia ligar sozinho.
  emailVerifiedAt      DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  /// Atualizado no login (senha ou Google) e na renovação de sessão. É o
  /// "último acesso" que o Admin mostra; nulo em conta que nunca entrou.
  lastLoginAt          DateTime?         @map("last_login_at") @db.Timestamptz(6)
  status               BrokerStatus      @default(ativo)
  /// Prova do aceite dos Termos e da Política de Privacidade no cadastro,
  /// exigida pela LGPD: quando aceitou e qual versão do texto estava no ar.
  /// Sem a versão, a prova não vale: um texto que mudou depois não diz a que
  /// o corretor concordou.
  termsAcceptedAt      DateTime?         @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion         String?           @map("terms_version")
  /// Aceite separado, opcional, para comunicações de marketing. Consentimento
  /// de marketing e de uso do serviço são coisas distintas na LGPD.
  marketingOptIn       Boolean           @default(false) @map("marketing_opt_in")
  /// Só para o registro interno de por que a conta foi suspensa. Nunca vai
  /// para a resposta da API.
  suspendedReason      String?           @map("suspended_reason")
  suspendedAt          DateTime?         @map("suspended_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads                Lead[]
  activities           LeadActivity[]
  agendaEvents         AgendaEvent[]
  documents            Document[]
  properties           Property[]
  propertyImports      PropertyImport[]
  visits               Visit[]
  simulations          Simulation[]
  selections           PropertySelection[]
  selectionItems       SelectionItem[]
  leadPreferences      LeadPreference[]
  visitAvailability    VisitAvailability?
  conversions          Conversion[]
  consents             Consent[]
  auditLogs            AuditLog[]
  clientProfiles       ClientProfile[]
  clientNegotiations   ClientNegotiation[]
  clientFinancials     ClientFinancial[]
  clientParticipants   ClientParticipant[]
  deletionRequests     DataDeletionRequest[]
  refreshTokens        RefreshToken[]
  resetTokens          PasswordResetToken[]
  emailTokens          EmailVerificationToken[]
  productEvents        ProductEvent[]
  guidanceProgress     GuidanceProgress[]
  onboardingProfile    OnboardingProfile?
  publicPage           BrokerPublicPage?
  notifications        Notification[]
  financingRequests    FinancingDataRequest[]
  financingDrafts      FinancingDataDraft[]
  financingSubmissions FinancingDataSubmission[]
  financingAccessCodes FinancingAccessCode[]

  @@map("broker")
}

// ---------------------------------------------------------------------------
// Tabelas de infraestrutura de autenticação
// ---------------------------------------------------------------------------
/// Por que o refresh token foi revogado. Serve para distinguir a rotação
/// normal (onde duas abas podem se atropelar sem malícia) de um encerramento
/// deliberado, que nunca deve ser tolerado como corrida.
enum RefreshRevokeReason {
  rotacao
  logout
  senha_redefinida
  reuso_detectado
}

model RefreshToken {
  id            String               @id @default(uuid()) @db.Uuid
  brokerId      String               @map("broker_id") @db.Uuid
  tokenHash     String               @unique @map("token_hash")
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshRevokeReason? @map("revoked_reason")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("refresh_token")
}

/// Mesma forma do token de redefinição: guardado só como hash, de uso único e
/// com validade. O que muda é o prazo, mais longo, porque confirmar e-mail não
/// é urgente como recuperar uma senha perdida.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  brokerId  String    @map("broker_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("email_verification_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  brokerId  String    @map("broker_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("password_reset_token")
}

// ---------------------------------------------------------------------------
// lead — entidade central
// ---------------------------------------------------------------------------
model Lead {
  id            String        @id @default(uuid()) @db.Uuid
  brokerId      String        @map("broker_id") @db.Uuid
  /// Número curto e legível, no mesmo padrão do imóvel. É o que aparece na
  /// URL (/leads/1042) e o que o corretor cita. O id continua sendo o uuid.
  code          Int           @unique @default(autoincrement())
  fullName      String        @map("full_name")
  whatsapp      String
  email         String?
  cpf           String?
  source        LeadSource?
  intent        LeadIntent?
  audience      LeadAudience?
  region        String?
  budgetMin     Decimal?      @map("budget_min") @db.Decimal(14, 2)
  budgetMax     Decimal?      @map("budget_max") @db.Decimal(14, 2)
  status        LeadStatus    @default(novo)
  isClient      Boolean       @default(false) @map("is_client")
  convertedAt   DateTime?     @map("converted_at") @db.Timestamptz(6)
  notes         String?
  lastContactAt DateTime?     @map("last_contact_at") @db.Timestamptz(6)
  nextActionAt  DateTime?     @map("next_action_at") @db.Timestamptz(6)
  lostReason    String?       @map("lost_reason")
  reactivateAt  DateTime?     @map("reactivate_at") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker            Broker                 @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  activities        LeadActivity[]
  agendaEvents      AgendaEvent[]
  documents         Document[]
  visits            Visit[]
  simulations       Simulation[]
  selections        PropertySelection[]
  preference        LeadPreference?
  conversion        Conversion?
  consents          Consent[]
  clientProfile     ClientProfile?
  clientNegotiation ClientNegotiation?
  clientFinancial   ClientFinancial?
  participants      ClientParticipant[]
  deletionRequests  DataDeletionRequest[]
  financingRequests FinancingDataRequest[]

  @@index([brokerId])
  @@index([status])
  @@index([isClient])
  @@index([nextActionAt])
  @@index([lastContactAt])
  @@map("lead")
}

// ---------------------------------------------------------------------------
// lead_activity — timeline imutável
// ---------------------------------------------------------------------------
model LeadActivity {
  id          String       @id @default(uuid()) @db.Uuid
  brokerId    String       @map("broker_id") @db.Uuid
  leadId      String       @map("lead_id") @db.Uuid
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("lead_activity")
}

// ---------------------------------------------------------------------------
// Conversão de lead em cliente (docs/02 §2.16). Lead e cliente são a MESMA
// pessoa: a conversão nunca duplica o cadastro. Existe no máximo uma por lead.
// ---------------------------------------------------------------------------
enum ConversionReason {
  inicio_financiamento
  solicitacao_documentos
  analise_cadastral
  preparacao_proposta
  negociacao_formal
  processo_locacao
  outro

  @@map("conversion_reason")
}

enum ConversionNextStep {
  coletar_dados
  solicitar_documentos
  registrar_simulacao
  preparar_proposta
  iniciar_analise_cadastral
  iniciar_negociacao

  @@map("conversion_next_step")
}

enum ClientPurpose {
  compra
  locacao

  @@map("client_purpose")
}

model Conversion {
  id           String             @id @default(uuid()) @db.Uuid
  brokerId     String             @map("broker_id") @db.Uuid
  leadId       String             @unique @map("lead_id") @db.Uuid
  convertedAt  DateTime           @default(now()) @map("converted_at") @db.Timestamptz(6)
  reason       ConversionReason
  reasonDetail String?            @map("reason_detail")
  nextStep     ConversionNextStep @map("next_step")
  purpose      ClientPurpose
  propertyId   String?            @map("property_id") @db.Uuid
  consentGiven Boolean            @default(false) @map("consent_given")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  broker   Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([brokerId])
  @@map("conversion")
}

// ---------------------------------------------------------------------------
// Perfil de cliente (fatia 2). Dados pessoais fora da tabela lead, coletados
// de forma progressiva: nenhum campo é obrigatório de cara; valida-se quando
// preenchido. Dados financeiros ficam em tabela própria (fatia 3).
// ---------------------------------------------------------------------------
enum MaritalStatus {
  solteiro
  casado
  uniao_estavel
  divorciado
  viuvo
  outro

  @@map("marital_status")
}

enum PaymentMethod {
  a_vista
  financiamento
  fgts_mais_financiamento
  permuta
  outro

  @@map("payment_method")
}

model ClientProfile {
  id               String         @id @default(uuid()) @db.Uuid
  brokerId         String         @map("broker_id") @db.Uuid
  leadId           String         @unique @map("lead_id") @db.Uuid
  cpf              String?
  rg               String?
  birthDate        DateTime?      @map("birth_date") @db.Date
  maritalStatus    MaritalStatus? @map("marital_status")
  nationality      String?
  residenceCountry String?        @map("residence_country")
  cep              String?
  street           String?
  addressNumber    String?        @map("address_number")
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  altPhone         String?        @map("alt_phone")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("client_profile")
}

// Estado atual da negociação (mutável). A conversão (2.16) é o registro
// histórico; aqui vive o que o corretor atualiza ao longo do atendimento.
model ClientNegotiation {
  id             String         @id @default(uuid()) @db.Uuid
  brokerId       String         @map("broker_id") @db.Uuid
  leadId         String         @unique @map("lead_id") @db.Uuid
  propertyValue  Decimal?       @map("property_value") @db.Decimal(14, 2)
  interestDate   DateTime?      @map("interest_date") @db.Date
  expectedTerm   String?        @map("expected_term")
  paymentMethod  PaymentMethod? @map("payment_method")
  needsFinancing Boolean?       @map("needs_financing")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("client_negotiation")
}

// ---------------------------------------------------------------------------
// Dados financeiros do cliente (fatia 3). Sensíveis por natureza: NUNCA em
// listas, Dashboard, URLs ou logs. Tabela própria, separada do perfil.
// ---------------------------------------------------------------------------
enum IncomeType {
  assalariado
  autonomo
  empresario
  aposentado
  profissional_liberal
  outro

  @@map("income_type")
}

model ClientFinancial {
  id                   String      @id @default(uuid()) @db.Uuid
  brokerId             String      @map("broker_id") @db.Uuid
  leadId               String      @unique @map("lead_id") @db.Uuid
  incomeType           IncomeType? @map("income_type")
  monthlyIncome        Decimal?    @map("monthly_income") @db.Decimal(14, 2)
  occupation           String?
  activityTime         String?     @map("activity_time")
  downPayment          Decimal?    @map("down_payment") @db.Decimal(14, 2)
  hasFgts              Boolean?    @map("has_fgts")
  preferredBank        String?     @map("preferred_bank")
  hasIncomeComposition Boolean?    @map("has_income_composition")
  dependentsCount      Int?        @map("dependents_count")
  notes                String?
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("client_financial")
}

// Participantes adicionais da operação (cônjuge, fiador, dependente...).
enum ParticipantRelation {
  conjuge
  comprador_conjunto
  locatario_conjunto
  fiador
  dependente
  procurador
  outro

  @@map("participant_relation")
}

model ClientParticipant {
  id        String              @id @default(uuid()) @db.Uuid
  brokerId  String              @map("broker_id") @db.Uuid
  leadId    String              @map("lead_id") @db.Uuid
  relation  ParticipantRelation
  fullName  String              @map("full_name")
  cpf       String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("client_participant")
}

// Solicitação de exclusão de dados (LGPD). Nesta fase é o REGISTRO da
// solicitação (não apaga automaticamente): há dados sob retenção obrigatória
// que exigem análise antes de excluir/anonimizar.
enum DeletionStatus {
  solicitada
  em_analise
  concluida
  negada

  @@map("deletion_status")
}

model DataDeletionRequest {
  id          String         @id @default(uuid()) @db.Uuid
  brokerId    String         @map("broker_id") @db.Uuid
  leadId      String         @map("lead_id") @db.Uuid
  status      DeletionStatus @default(solicitada)
  reason      String?
  requestedAt DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  handledAt   DateTime?      @map("handled_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("data_deletion_request")
}

// Registro de consentimento LGPD. Não é um checkbox genérico: guarda a
// finalidade, a versão do texto apresentado e quem registrou.
model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  brokerId    String   @map("broker_id") @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  purpose     String
  textVersion String   @map("text_version")
  /// Quem registrou: null = corretor no sistema (histórico); "formulario_publico"
  /// = o próprio cliente, pelo link seguro (docs/09).
  origin      String?
  acceptedAt  DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("consent")
}

// Trilha de auditoria de ações sensíveis. NUNCA guarda conteúdo sensível
// (CPF, renda, documento, token): só quem fez, quando, o quê e sobre qual
// entidade, mais metadados não sensíveis.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  brokerId   String   @map("broker_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// task — próxima ação / follow-up
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// agenda_event — evento unificado da agenda do corretor
// ---------------------------------------------------------------------------
// Um só registro para tarefa, visita, compromisso geral, bloqueio de horário e
// "ocupado" vindo do Google. O Nexlar é a fonte principal: eventos nascem aqui
// e depois são enviados ao Google (sync_status). Os campos google_* ficam
// preparados para a Fatia 2 (integração). Datas sempre em UTC no banco.
enum AgendaEventType {
  tarefa
  visita
  compromisso
  bloqueio
  google_ocupado

  @@map("agenda_event_type")
}

enum AgendaEventSource {
  nexlar
  google

  @@map("agenda_event_source")
}

enum AgendaSyncStatus {
  nao_sincronizado
  pendente
  sincronizado
  alterado
  erro
  desconectado

  @@map("agenda_sync_status")
}

// Status cobre todos os tipos. Tarefa usa pendente/concluida/cancelada;
// compromisso e bloqueio usam agendado; visita usa o ciclo próprio
// (solicitada..aguardando_feedback), consumido a partir da sub-fatia B.
enum AgendaEventStatus {
  pendente
  concluida
  cancelada
  agendado
  solicitada
  aguardando_confirmacao
  confirmada
  realizada
  remarcada
  nao_compareceu
  aguardando_feedback

  @@map("agenda_event_status")
}

model AgendaEvent {
  id               String            @id @default(uuid()) @db.Uuid
  brokerId         String            @map("broker_id") @db.Uuid
  type             AgendaEventType
  leadId           String?           @map("lead_id") @db.Uuid
  propertyId       String?           @map("property_id") @db.Uuid
  /// Evento de visita nascido de um agendamento: aponta o registro de Visit
  /// para cancelamento e remarcação andarem juntos nos dois lugares.
  visitId          String?           @map("visit_id") @db.Uuid
  title            String
  description      String?
  location         String?
  startAt          DateTime          @map("start_at") @db.Timestamptz(6)
  endAt            DateTime?         @map("end_at") @db.Timestamptz(6)
  allDay           Boolean           @default(false) @map("all_day")
  status           AgendaEventStatus @default(agendado)
  taskKind         String?           @map("task_kind")
  reminderMinutes  Int?              @map("reminder_minutes")
  recurrence       String?
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  source           AgendaEventSource @default(nexlar)
  syncStatus       AgendaSyncStatus  @default(nao_sincronizado) @map("sync_status")
  googleCalendarId String?           @map("google_calendar_id")
  googleEventId    String?           @map("google_event_id")
  googleUpdatedAt  DateTime?         @map("google_updated_at") @db.Timestamptz(6)
  lastSyncAt       DateTime?         @map("last_sync_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker   Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  visit    Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([brokerId])
  @@index([leadId])
  @@index([propertyId])
  @@index([visitId])
  @@index([brokerId, startAt])
  @@map("agenda_event")
}

// ---------------------------------------------------------------------------
// document — documentos por etapa
// ---------------------------------------------------------------------------
model Document {
  id        String         @id @default(uuid()) @db.Uuid
  brokerId  String         @map("broker_id") @db.Uuid
  leadId    String         @map("lead_id") @db.Uuid
  docType   DocumentType   @map("doc_type")
  stage     DocumentStage
  filePath  String?        @map("file_path")
  fileName  String?        @map("file_name")
  status    DocumentStatus @default(pendente)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("document")
}

// ---------------------------------------------------------------------------
// property — cadastro leve de imóvel
// ---------------------------------------------------------------------------
// O imóvel é um registro PRIVADO na carteira do corretor (broker_id = quem
// controla). Imobiliária, proprietário e parceiros são apenas a origem,
// registrados em origin/originDetails e nos contatos. Campos específicos por
// tipo (quartos, docas, frente...) vivem em details (Json) validado no shared.
model Property {
  id       String @id @default(uuid()) @db.Uuid
  brokerId String @map("broker_id") @db.Uuid
  code     Int    @unique @default(autoincrement())

  title    String
  purpose  PropertyPurpose
  category PropertyCategory
  type     String
  status   PropertyStatus   @default(rascunho)

  description   String?
  internalNotes String? @map("internal_notes")
  externalCode  String? @map("external_code")
  externalLink  String? @map("external_link")

  origin        PropertyOrigin
  originDetails Json?          @map("origin_details")

  // Localização
  zip            String?
  street         String?
  addressNumber  String?            @map("address_number")
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  country        String             @default("Brasil")
  latitude       Float?
  longitude      Float?
  reference      String?
  condoName      String?            @map("condo_name")
  addressDisplay AddressDisplayMode @default(completo) @map("address_display")

  // Valores (venda)
  salePrice        Decimal? @map("sale_price") @db.Decimal(14, 2)
  acceptsFinancing Boolean? @map("accepts_financing")
  acceptsFgts      Boolean? @map("accepts_fgts")
  acceptsTrade     Boolean? @map("accepts_trade")
  priceNegotiable  Boolean? @map("price_negotiable")
  commissionNotes  String?  @map("commission_notes")

  // Valores (locação)
  rentPrice      Decimal?  @map("rent_price") @db.Decimal(14, 2)
  condoFee       Decimal?  @map("condo_fee") @db.Decimal(14, 2)
  iptu           Decimal?  @db.Decimal(14, 2)
  otherFees      String?   @map("other_fees")
  guaranteeTypes String?   @map("guarantee_types")
  minTermMonths  Int?      @map("min_term_months")
  furnished      Boolean?
  availableFrom  DateTime? @map("available_from") @db.Date
  rentNotes      String?   @map("rent_notes")

  // Campos específicos do tipo + comodidades
  details  Json?
  features String[] @default([])

  // Vitrine pública (/corretor/:slug). Anúncio é para ser visto: o imóvel nasce
  // público e o corretor tira do ar o que não quiser divulgar. Só entra na
  // página de fato quem passa na elegibilidade e tem a página ativa. `oculto`
  // guarda a intenção de já ter sido publicado e ter saído do ar, o que é
  // diferente de nunca ter entrado.
  publicVisibility PropertyPublicVisibility @default(publico) @map("public_visibility")
  publicSince      DateTime?                @map("public_since") @db.Timestamptz(6)
  /// Posição no bloco de destaques da página (1 a 6). Nulo = não é destaque.
  highlightOrder   Int?                     @map("highlight_order")

  // Disponibilidade operacional (separada do status do anúncio)
  availabilityConfirmed    Boolean   @default(false) @map("availability_confirmed")
  availabilityConfirmedAt  DateTime? @map("availability_confirmed_at") @db.Timestamptz(6)
  availabilityConfirmedBy  String?   @map("availability_confirmed_by")
  availabilityNextReviewAt DateTime? @map("availability_next_review_at") @db.Date
  availabilityNote         String?   @map("availability_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker            Broker                 @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  visitProperties   VisitProperty[]
  agendaEvents      AgendaEvent[]
  conversions       Conversion[]
  contacts          PropertyContact[]
  media             PropertyMedia[]
  sharedItems       SelectionItem[]
  financingRequests FinancingDataRequest[]
  imports           PropertyImport[]

  @@index([brokerId])
  @@index([brokerId, publicVisibility])
  @@index([brokerId, status])
  @@index([brokerId, city])
  @@index([externalCode])
  @@map("property")
}

// Pessoas envolvidas no imóvel. Uma pessoa pode ter vários papéis.
model PropertyContact {
  id         String                @id @default(uuid()) @db.Uuid
  brokerId   String                @map("broker_id") @db.Uuid
  propertyId String                @map("property_id") @db.Uuid
  name       String
  roles      PropertyContactRole[]
  phone      String?
  whatsapp   String?
  email      String?
  creci      String?
  agencyName String?               @map("agency_name")
  notes      String?
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([propertyId])
  @@map("property_contact")
}

// Fotos, vídeos, plantas e links do imóvel. A mídia pertence ao cadastro do
// corretor mesmo quando a origem é externa; authorized registra a confirmação
// de autorização de uso. Arquivos ficam em área privada:
// brokers/{broker_id}/properties/{property_id}/{images|videos}/{media_id}
model PropertyMedia {
  id          String      @id @default(uuid()) @db.Uuid
  brokerId    String      @map("broker_id") @db.Uuid
  propertyId  String      @map("property_id") @db.Uuid
  kind        MediaKind
  origin      MediaOrigin @default(corretor)
  authorized  Boolean     @default(false)
  status      MediaStatus @default(pronto)
  storagePath String?     @map("storage_path")
  externalUrl String?     @map("external_url")
  mimeType    String?     @map("mime_type")
  sizeBytes   Int?        @map("size_bytes")
  caption     String?
  room        PhotoRoom?
  isCover     Boolean     @default(false) @map("is_cover")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([propertyId])
  @@map("property_media")
}

// ---------------------------------------------------------------------------
// property_import — importação de imóvel por URL (docs/10)
// ---------------------------------------------------------------------------
// Auditoria de cada importação: de onde veio, o que a extração encontrou e
// qual rascunho nasceu. Guarda só o RESULTADO estruturado (payload), nunca o
// conteúdo integral da página. Excluir o imóvel não apaga o registro: a
// trilha de auditoria sobrevive ao rascunho descartado (property_id vira nulo).
model PropertyImport {
  id       String @id @default(uuid()) @db.Uuid
  brokerId String @map("broker_id") @db.Uuid

  url        String
  finalUrl   String?              @map("final_url")
  domain     String
  status     PropertyImportStatus
  httpStatus Int?                 @map("http_status")

  /// Extração canônica: campo a campo com valor, fonte e evidência.
  payload Json?
  /// Contagens do resumo mostrado ao corretor (encontrados, revisar, ausentes).
  summary Json?
  /// Código interno do erro quando a importação falha (ex.: inacessivel).
  error   String?

  propertyId String? @map("property_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  broker   Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([propertyId])
  @@map("property_import")
}

enum PropertyImportStatus {
  concluida
  duplicada
  falhou

  @@map("property_import_status")
}

// ---------------------------------------------------------------------------
// visit — visitas
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// visit_availability — horários em que o corretor aceita visitas
// ---------------------------------------------------------------------------
// Uma linha por corretor. As janelas ficam em Json validado pelo zod:
// [{ weekday: 0-6, start: "09:00", end: "18:00" }]. Sem linha (ou sem
// janelas) = agenda não configurada, e a página da lead cai no fallback de
// solicitação. Fuso fixo America/Sao_Paulo por ora: corretor solo no Brasil.
model VisitAvailability {
  id       String @id @default(uuid()) @db.Uuid
  brokerId String @unique @map("broker_id") @db.Uuid

  windows         Json @default("[]")
  slotDurationMin Int  @default(60) @map("slot_duration_min")
  /// Antecedência mínima em horas: a lead não agenda para daqui a 20 minutos.
  minNoticeHours  Int  @default(12) @map("min_notice_hours")
  /// Até quantos dias no futuro a lead consegue agendar.
  maxAdvanceDays  Int  @default(14) @map("max_advance_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("visit_availability")
}

model Visit {
  id          String      @id @default(uuid()) @db.Uuid
  brokerId    String      @map("broker_id") @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  scheduledAt DateTime    @map("scheduled_at") @db.Timestamptz(6)
  status      VisitStatus @default(agendada)
  feedback    String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker       Broker          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  properties   VisitProperty[]
  agendaEvents AgendaEvent[]

  @@index([brokerId])
  @@index([leadId])
  @@map("visit")
}

// ---------------------------------------------------------------------------
// visit_property — N:N entre visita e imóveis apresentados
// ---------------------------------------------------------------------------
model VisitProperty {
  visitId    String @map("visit_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([visitId, propertyId])
  @@index([propertyId])
  @@map("visit_property")
}

// ---------------------------------------------------------------------------
// simulation — registro de simulação bancária
// ---------------------------------------------------------------------------
model Simulation {
  id                 String           @id @default(uuid()) @db.Uuid
  brokerId           String           @map("broker_id") @db.Uuid
  leadId             String           @map("lead_id") @db.Uuid
  bank               String           @default("Caixa")
  propertyValue      Decimal?         @map("property_value") @db.Decimal(14, 2)
  downPayment        Decimal?         @map("down_payment") @db.Decimal(14, 2)
  financedAmount     Decimal?         @map("financed_amount") @db.Decimal(14, 2)
  termMonths         Int?             @map("term_months")
  monthlyInstallment Decimal?         @map("monthly_installment") @db.Decimal(14, 2)
  subsidy            Decimal?         @db.Decimal(14, 2)
  status             SimulationStatus @default(pendente)
  resultNotes        String?          @map("result_notes")
  simulatedAt        DateTime?        @map("simulated_at") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([leadId])
  @@map("simulation")
}

// ---------------------------------------------------------------------------
// financing_data_request: coleta de dados para simulação de financiamento
// ---------------------------------------------------------------------------
// O corretor pede, o cliente preenche por link seguro, o corretor revisa e
// aprova. A Nexlar organiza; quem analisa crédito é o banco (docs/09).
/// Estados enxutos de propósito: abrir, começar a preencher e reenviar são
/// fatos datados (firstOpenedAt, startedAt, currentVersion), não estados,
/// no mesmo espírito de viewedAt/viewCount da seleção.
enum FinancingRequestStatus {
  rascunho
  enviada
  respondida
  em_revisao
  correcao_solicitada
  aprovada_para_simulacao
  expirada
  revogada
  arquivada

  @@map("financing_request_status")
}

model FinancingDataRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  brokerId          String                 @map("broker_id") @db.Uuid
  leadId            String                 @map("lead_id") @db.Uuid
  /// Imóvel de interesse. Opcional: a coleta pode nascer da ficha, antes de
  /// existir imóvel definido.
  propertyId        String?                @map("property_id") @db.Uuid
  /// Número curto para a URL interna (/leads/1042/financiamento/3), padrão da
  /// lead e da seleção. Sem relação com o token público.
  code              Int                    @unique @default(autoincrement())
  status            FinancingRequestStatus @default(rascunho)
  /// SHA-256 do token do link público. O token em si só existe na URL enviada
  /// ao cliente: vazar o banco não vaza o link (padrão dos tokens de auth,
  /// corrigindo o que a seleção fez em texto puro).
  tokenHash         String?                @unique @map("token_hash")
  /// Blocos do formulário que o corretor pediu (vocabulário no shared).
  requestedSections String[]               @default([]) @map("requested_sections")
  message           String?
  /// Prazo escolhido pelo corretor; o backend calcula expiresAt no envio.
  /// Editar nunca renova o prazo, igual à seleção.
  expiresInDays     Int?                   @map("expires_in_days")
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(6)
  firstOpenedAt     DateTime?              @map("first_opened_at") @db.Timestamptz(6)
  startedAt         DateTime?              @map("started_at") @db.Timestamptz(6)
  submittedAt       DateTime?              @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  revokedAt         DateTime?              @map("revoked_at") @db.Timestamptz(6)
  archivedAt        DateTime?              @map("archived_at") @db.Timestamptz(6)
  /// Quantas versões o cliente já enviou. 0 = nenhuma. Reenvio após correção
  /// incrementa; a submissão de cada versão é imutável.
  currentVersion    Int                    @default(0) @map("current_version")
  consentVersion    String?                @map("consent_version")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker      Broker                    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead        Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property    Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  draft       FinancingDataDraft?
  submissions FinancingDataSubmission[]
  accessCodes FinancingAccessCode[]

  @@index([brokerId])
  @@index([leadId])
  @@map("financing_data_request")
}

/// Rascunho mutável do preenchimento (autosave). Uma por solicitação. O
/// payload é Json validado por seção no shared, padrão property.details.
model FinancingDataDraft {
  id                String   @id @default(uuid()) @db.Uuid
  brokerId          String   @map("broker_id") @db.Uuid
  requestId         String   @unique @map("request_id") @db.Uuid
  payload           Json     @default("{}")
  /// Seções que o cliente marcou como concluídas (progresso do formulário).
  completedSections String[] @default([]) @map("completed_sections")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Base da detecção de conflito do autosave entre dispositivos.
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker  Broker               @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  request FinancingDataRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("financing_data_draft")
}

/// Versão imutável do que o cliente enviou. Nunca recebe UPDATE: correção
/// gera versão nova. É a prova do que foi declarado e quando.
model FinancingDataSubmission {
  id               String   @id @default(uuid()) @db.Uuid
  brokerId         String   @map("broker_id") @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  version          Int
  payload          Json
  /// Consentimento registrado no envio desta versão.
  consentId        String?  @map("consent_id") @db.Uuid
  /// Quando a versão nasce de um pedido de correção: o que o corretor pediu.
  correctionNote   String?  @map("correction_note")
  correctionFields String[] @default([]) @map("correction_fields")
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  broker  Broker               @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  request FinancingDataRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, version])
  @@index([brokerId])
  @@map("financing_data_submission")
}

/// Código de uso único enviado por e-mail para confirmar a identidade do
/// cliente antes de abrir o formulário. Mesmo molde do PasswordResetToken,
/// com contador de tentativas porque código curto se adivinha por força
/// bruta, link longo não.
model FinancingAccessCode {
  id           String    @id @default(uuid()) @db.Uuid
  brokerId     String    @map("broker_id") @db.Uuid
  requestId    String    @map("request_id") @db.Uuid
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  broker  Broker               @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  request FinancingDataRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([brokerId])
  @@map("financing_access_code")
}

// ---------------------------------------------------------------------------
// property_selection — envio/compartilhamento de imóveis para uma lead.
// Um envio de um único imóvel é uma seleção com um item (ver docs/02 2.13).
// ---------------------------------------------------------------------------
/// Ciclo de vida da seleção (docs da épica Seleção Personalizada). O fato de
/// a lead ter visualizado não é estado do link: fica em viewedAt/viewCount.
enum SelectionStatus {
  rascunho
  ativa
  expirada
  revogada
  arquivada

  @@map("selection_status")
}

/// Como o imóvel entrou na seleção: sugerido pelos filtros das preferências
/// da lead ou escolhido manualmente pelo corretor fora do perfil.
enum SelectionItemOrigin {
  preferencia
  manual

  @@map("selection_item_origin")
}

/// Compatibilidade calculada por regras determinísticas entre o imóvel e as
/// preferências da lead no momento da inclusão. Nulo = sem preferências.
enum SelectionCompatibility {
  alta
  media
  baixa
  fora_do_perfil

  @@map("selection_compatibility")
}

enum SelectionResponse {
  nao_visualizado
  visualizado
  tenho_interesse
  talvez
  sem_interesse
  quero_visitar

  @@map("selection_response")
}

model PropertySelection {
  id            String          @id @default(uuid()) @db.Uuid
  brokerId      String          @map("broker_id") @db.Uuid
  leadId        String          @map("lead_id") @db.Uuid
  /// Número curto para a URL do montador (/leads/1042/selecoes/7). Não tem
  /// relação com o publicToken, que é o segredo do link da lead.
  code          Int             @unique @default(autoincrement())
  publicToken   String          @unique @map("public_token")
  status        SelectionStatus @default(rascunho)
  message       String?
  /// Prazo escolhido pelo corretor (7, 15 ou 30 dias). O backend calcula
  /// expiresAt na ativação; editar a seleção nunca renova o prazo.
  expiresInDays Int?            @map("expires_in_days")
  activatedAt   DateTime?       @map("activated_at") @db.Timestamptz(6)
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(6)
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz(6)
  viewedAt      DateTime?       @map("viewed_at") @db.Timestamptz(6)
  lastAccessAt  DateTime?       @map("last_access_at") @db.Timestamptz(6)
  viewCount     Int             @default(0) @map("view_count")
  resendCount   Int             @default(0) @map("resend_count")
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items  SelectionItem[]

  @@index([brokerId])
  @@index([leadId])
  @@map("property_selection")
}

model SelectionItem {
  id               String                  @id @default(uuid()) @db.Uuid
  brokerId         String                  @map("broker_id") @db.Uuid
  selectionId      String                  @map("selection_id") @db.Uuid
  propertyId       String                  @map("property_id") @db.Uuid
  position         Int                     @default(0)
  /// Destaque na página da lead (máximo de 3 por seleção, regra no serviço).
  highlight        Boolean                 @default(false)
  /// Observação do corretor sobre este imóvel para esta lead ("tem a varanda
  /// que você pediu"). Aparece na página pública.
  brokerNote       String?                 @map("broker_note")
  origin           SelectionItemOrigin     @default(manual)
  compatibility    SelectionCompatibility?
  response         SelectionResponse       @default(nao_visualizado)
  respondedAt      DateTime?               @map("responded_at") @db.Timestamptz(6)
  /// Motivo do "não combina comigo" escolhido pela lead (preço, localização...).
  responseReason   String?                 @map("response_reason")
  comment          String?
  visitRequestedAt DateTime?               @map("visit_requested_at") @db.Timestamptz(6)
  isPriority       Boolean                 @default(false) @map("is_priority")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker    Broker            @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  selection PropertySelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([selectionId, propertyId])
  @@index([brokerId])
  @@index([selectionId])
  @@index([propertyId])
  @@map("selection_item")
}

// ---------------------------------------------------------------------------
// lead_preference — o que a lead procura, em campos estruturados
// ---------------------------------------------------------------------------
// A ficha da lead sempre teve intenção, região livre e faixa de orçamento;
// isto aqui é a versão pesquisável que alimenta os filtros e a compatibilidade
// da seleção personalizada. No máximo uma por lead.
model LeadPreference {
  id       String @id @default(uuid()) @db.Uuid
  brokerId String @map("broker_id") @db.Uuid
  leadId   String @unique @map("lead_id") @db.Uuid

  purpose       PropertyPurpose?
  /// Tipos de imóvel aceitos (mesmo vocabulário livre de property.type).
  types         String[]         @default([])
  cities        String[]         @default([])
  neighborhoods String[]         @default([])
  priceMin      Decimal?         @map("price_min") @db.Decimal(14, 2)
  priceMax      Decimal?         @map("price_max") @db.Decimal(14, 2)
  bedroomsMin   Int?             @map("bedrooms_min")
  bathroomsMin  Int?             @map("bathrooms_min")
  parkingMin    Int?             @map("parking_min")
  areaMin       Int?             @map("area_min")
  areaMax       Int?             @map("area_max")
  furnished     Boolean?
  /// Comodidades desejadas (mesmo vocabulário de property.features).
  features      String[]         @default([])
  /// O que a lead NÃO aceita, em texto livre ("nada em rua movimentada").
  restrictions  String?
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("lead_preference")
}

// ===========================================================================
// Jornada 2 — Experiência guiada e inteligente
// ---------------------------------------------------------------------------
// Camada transversal que aprende com o que o corretor faz e aponta o próximo
// passo. Três tabelas, todas isoladas por broker_id (o Nexlar é single-user
// por corretor; não existe organization_id).
// ===========================================================================

/// Estado de uma orientação para um corretor. Fechar (dismissed) não é
/// concluir: só o evento real da ação marca completed (regra GUI-04).
enum GuidanceStatus {
  available // elegível, ainda não exibida
  shown // já apresentada
  dismissed // o corretor fechou
  skipped // o corretor deixou para depois
  in_progress // iniciou a ação relacionada
  completed // concluiu a ação real
  reopened // reabriu uma orientação dispensada
  expired // perdeu relevância pela mudança de contexto

  @@map("guidance_status")
}

/// Respostas do diagnóstico inicial. Enums pequenos e fechados; tudo opcional
/// porque o diagnóstico pode ser pulado.
enum WorkMode {
  sozinho
  imobiliaria

  @@map("work_mode")
}

enum BusinessFocus {
  venda
  locacao
  ambos

  @@map("business_focus")
}

/// Log append-only de uso e aprendizado. É o "sistema nervoso" da jornada:
/// espelha o molde imutável de lead_activity, mas cobre a conta inteira, não
/// só uma lead. NUNCA guarda dado sensível de lead/cliente/imóvel, apenas
/// referências (entityType + entityId) e metadados mínimos (regra da §9).
///
/// O `type` é String de propósito, não enum do Prisma: o catálogo de eventos
/// cresce, e um enum obrigaria migration a cada evento novo. A validação mora
/// no serviço, contra a lista de PRODUCT_EVENTS do pacote shared.
///
/// Idempotência (§27): eventos de "primeira vez" gravam um `dedupeKey` (o
/// próprio tipo). O índice único (broker_id, dedupe_key) impede duplicar o
/// marco. Eventos repetíveis (GUIDANCE_SHOWN) deixam dedupeKey nulo, e no
/// Postgres nulos são distintos entre si, então repetem à vontade.
model ProductEvent {
  id         String   @id @default(uuid()) @db.Uuid
  brokerId   String   @map("broker_id") @db.Uuid
  type       String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  source     String   @default("system")
  dedupeKey  String?  @map("dedupe_key")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, dedupeKey], name: "broker_dedupe")
  @@index([brokerId])
  @@index([brokerId, type])
  @@map("product_event")
}

/// Estado por corretor de cada orientação. A chave da orientação
/// (guidance_key) casa com o registry de definições que vive em código.
model GuidanceProgress {
  id           String         @id @default(uuid()) @db.Uuid
  brokerId     String         @map("broker_id") @db.Uuid
  guidanceKey  String         @map("guidance_key")
  status       GuidanceStatus @default(available)
  showCount    Int            @default(0) @map("show_count")
  firstShownAt DateTime?      @map("first_shown_at") @db.Timestamptz(6)
  lastShownAt  DateTime?      @map("last_shown_at") @db.Timestamptz(6)
  dismissedAt  DateTime?      @map("dismissed_at") @db.Timestamptz(6)
  completedAt  DateTime?      @map("completed_at") @db.Timestamptz(6)
  reopenedAt   DateTime?      @map("reopened_at") @db.Timestamptz(6)
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, guidanceKey], name: "broker_guidance")
  @@index([brokerId])
  @@map("guidance_progress")
}

/// Respostas do diagnóstico inicial, uma linha por corretor (1:1). Personaliza
/// a priorização das recomendações. Tudo opcional: o diagnóstico é pulável.
model OnboardingProfile {
  id                    String         @id @default(uuid()) @db.Uuid
  brokerId              String         @unique @map("broker_id") @db.Uuid
  workMode              WorkMode?      @map("work_mode")
  businessFocus         BusinessFocus? @map("business_focus")
  hasExistingLeads      Boolean?       @map("has_existing_leads")
  hasExistingProperties Boolean?       @map("has_existing_properties")
  calendarProvider      String?        @map("calendar_provider")
  diagnosisCompleted    Boolean        @default(false) @map("diagnosis_completed")
  diagnosisSkipped      Boolean        @default(false) @map("diagnosis_skipped")
  firstAccessAt         DateTime?      @map("first_access_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("onboarding_profile")
}

// ---------------------------------------------------------------------------
// broker_public_page — a vitrine pública do corretor (/corretor/:slug)
// ---------------------------------------------------------------------------
/// Estado da página, em português como o resto da casa. `incompleta` é o
/// estado de quem tentou publicar (ou já esteve no ar) sem os requisitos
/// mínimos; `restrita` só entra e sai por script administrativo, nunca pelo
/// front. Só `ativa` responde na rota pública.
enum PublicPageStatus {
  rascunho
  incompleta
  ativa
  pausada
  restrita

  @@map("public_page_status")
}

/// Perfil público do corretor, 1:1 com a conta. Guarda SÓ o que pode ir a
/// público; nada aqui é segredo, mas o contrário importa: dado privado do
/// corretor (e-mail de login, documento do CRECI, telefone pessoal) NUNCA
/// entra nesta tabela. Contatos públicos são campos próprios de propósito,
/// para o corretor poder divulgar um número diferente do que usa no login.
///
/// Reuso consciente (sem duplicar): foto vem de broker.avatar_url, selo e
/// número do CRECI vêm de broker.creci_status/creci, imobiliária de
/// broker.agency_name. Esta tabela guarda o que só existe na vitrine.
model BrokerPublicPage {
  id       String @id @default(uuid()) @db.Uuid
  brokerId String @unique @map("broker_id") @db.Uuid

  /// Endereço público escolhido pelo corretor: nexlar.app/corretor/{slug}.
  /// Único no sistema inteiro; normalização e palavras reservadas moram no
  /// serviço, a constraint garante contra corrida.
  slug   String?          @unique
  status PublicPageStatus @default(rascunho)

  /// Nome de vitrine. Nasce pré-preenchido com o full_name, mas é campo
  /// próprio: o corretor pode assinar diferente do nome civil.
  professionalName String? @map("professional_name")
  /// Título ou especialidade curta ("Especialista em lançamentos na Zona Sul").
  headline         String?
  bio              String?

  mainCity      String?        @map("main_city")
  regions       String[]       @default([])
  /// Foco do negócio; reusa o enum do diagnóstico da Jornada 2.
  focus         BusinessFocus?
  propertyTypes String[]       @default([]) @map("property_types")
  languages     String[]       @default([])

  /// Contatos de divulgação, separados dos privados da conta.
  publicWhatsapp String? @map("public_whatsapp")
  publicPhone    String? @map("public_phone")
  publicEmail    String? @map("public_email")
  website        String?
  instagram      String?
  /// Texto livre curto ("Seg a Sáb, 9h às 19h"). Estruturar é dívida futura.
  serviceHours   String? @map("service_hours")
  /// Logotipo da imobiliária, quando o corretor quiser exibir.
  agencyLogoUrl  String? @map("agency_logo_url")

  /// Aceite dos termos de publicação (responsabilidade pelo conteúdo).
  /// Requisito mínimo para publicar; versão junto, como manda a LGPD.
  publicationTermsAcceptedAt DateTime? @map("publication_terms_accepted_at") @db.Timestamptz(6)
  publicationTermsVersion    String?   @map("publication_terms_version")

  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  pausedAt         DateTime? @map("paused_at") @db.Timestamptz(6)
  /// Motivo interno da restrição. Nunca vai para resposta pública.
  restrictedReason String?   @map("restricted_reason")
  restrictedAt     DateTime? @map("restricted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("broker_public_page")
}

// Notificações para o corretor sobre eventos da página pública.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  brokerId  String    @map("broker_id") @db.Uuid
  type      String
  title     String
  body      String
  actionUrl String?   @map("action_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, createdAt(sort: Desc)])
  @@map("notification")
}

// ===========================================================================
// Nexlar Admin — universo administrativo, separado do corretor
// ===========================================================================
// Admin é gente separada, não flag: tabela própria, segredo JWT próprio,
// guard próprio. Se uma pessoa da equipe também for corretora, são duas
// contas, e os universos não se tocam (docs/10, §5.3). Nenhum modelo daqui
// se relaciona com Broker.

/// Papéis internos da equipe Nexlar. Papel concede permissões (o catálogo
/// vive em @nexlar/shared, ROLE_PERMISSIONS); os guards verificam permissão,
/// nunca o nome do papel.
enum AdminRole {
  super_admin
  admin
  suporte
  financeiro

  @@map("admin_role")
}

enum AdminStatus {
  ativo
  suspenso

  @@map("admin_status")
}

model AdminUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  /// Vínculo com a conta Google (claim `sub`), gravado no PRIMEIRO login
  /// pelo Google de um admin já existente. No Admin o Google autentica,
  /// nunca cadastra: e-mail desconhecido é recusado sem criar nada.
  googleId     String?     @unique @map("google_id")
  fullName     String      @map("full_name")
  role         AdminRole
  status       AdminStatus @default(ativo)
  /// Reservado para MFA (Task 38 da épica). Nulo até existir a interface;
  /// a coluna nasce agora para o dia do MFA não precisar de migration.
  mfaSecret    String?     @map("mfa_secret")
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens AdminRefreshToken[]
  auditEntries  AdminAuditLog[]

  @@map("admin_user")
}

/// Espelho do RefreshToken do corretor, com uma diferença de política: a
/// sessão administrativa tem teto absoluto (a rotação NÃO estende o prazo,
/// ver AdminTokenService). Sessão privilegiada não deve durar um expediente
/// inteiro só porque ficou ativa.
model AdminRefreshToken {
  id            String               @id @default(uuid()) @db.Uuid
  adminUserId   String               @map("admin_user_id") @db.Uuid
  tokenHash     String               @unique @map("token_hash")
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshRevokeReason? @map("revoked_reason")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_refresh_token")
}

/// Trilha de auditoria administrativa: QUEM fez O QUÊ, EM QUAL recurso,
/// QUANDO, DE qual estado PARA qual estado.
///
/// Duas decisões deliberadas de integridade (docs/10, R2):
/// - O ator é Restrict, não Cascade: administrador com histórico não pode
///   ser apagado, só suspenso. Apagar o ator apagaria a autoria da trilha.
/// - O alvo (resource_id) é String sem FK: a trilha sobrevive à exclusão do
///   recurso. Auditoria que some junto com o alvo não prova nada.
model AdminAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  actorAdminId  String    @map("actor_admin_id") @db.Uuid
  /// Papel do ator NO MOMENTO da ação. O papel no admin_user pode mudar
  /// depois, e a trilha precisa contar a história como ela foi.
  actorRole     AdminRole @map("actor_role")
  action        String
  resourceType  String    @map("resource_type")
  resourceId    String?   @map("resource_id")
  previousState Json?     @map("previous_state")
  newState      Json?     @map("new_state")
  reason        String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor AdminUser @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([actorAdminId])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}
