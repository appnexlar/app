# Nexlar API — variáveis de ambiente (copie para .env e ajuste)

# Banco (docker-compose local usa nexlar/nexlar).
# DIRECT_URL é a conexão que o Prisma usa para rodar migration. No local ela é
# igual à DATABASE_URL; em produção (Supabase) são diferentes, ver
# .env.production.example.
DATABASE_URL="postgresql://nexlar:nexlar@localhost:5432/nexlar_dev?schema=public"
DIRECT_URL="postgresql://nexlar:nexlar@localhost:5432/nexlar_dev?schema=public"

# JWT — troque os segredos em produção
JWT_ACCESS_SECRET="troque-este-segredo-de-access-em-producao"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# App
PORT=3333
NODE_ENV=development

# CORS — origem do front
WEB_ORIGIN="http://localhost:5173"

# URL do front usada nos links de e-mail (recuperação de senha)
WEB_APP_URL="http://localhost:5173"

# Envio de e-mail (Resend). Deixe vazio em desenvolvimento: sem chave, os
# e-mails só aparecem no log da API, que é onde você pega o link de teste.
RESEND_API_KEY=""
EMAIL_FROM="Nexlar <onboarding@resend.dev>"

# Quantos proxies existem na frente da API, para o limite de tentativas saber
# de qual IP veio a requisição. Rodando direto na máquina, é 0.
TRUST_PROXY_HOPS=0

# Storage de midia. Em desenvolvimento grava em disco.
STORAGE_DRIVER=local
STORAGE_DIR="./storage"

# So usados quando STORAGE_DRIVER=s3. Ver .env.production.example.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="nexlar"
S3_SECRET_KEY="nexlar-secret"
S3_BUCKET="nexlar-documents"
