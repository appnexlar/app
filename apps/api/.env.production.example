# Nexlar API em produção, com banco no Supabase.
#
# Este arquivo é só um modelo e vai para o GitHub. Nunca escreva valor real
# aqui. Copie para .env.production (que o git ignora) ou cole direto no painel
# do provedor onde a API roda.
#
# Onde achar as strings no Supabase: painel do projeto, Settings, Database,
# seção Connection string. A senha é a que você definiu ao criar o projeto.
# Se tiver esquecido, dá para gerar outra em Database, Reset database password.

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# DATABASE_URL: conexão pela porta 6543 (pooler em modo transaction). É a que a
# aplicação usa o tempo todo. Os dois parâmetros do final não são opcionais:
# pgbouncer=true faz o Prisma parar de usar prepared statements, que o pooler
# não suporta, e connection_limit=1 evita estourar o limite de conexões.
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: conexão direta pela porta 5432. Usada só pelo Prisma para rodar
# migration, porque o pooler não aceita os comandos de alteração de estrutura.
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
# Gere valores novos, nunca reaproveite os de desenvolvimento. Um comando:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esses segredos desconecta todo mundo que estiver logado.
JWT_ACCESS_SECRET="gere-um-valor-novo-e-longo"
JWT_REFRESH_SECRET="gere-outro-valor-novo-e-diferente-do-de-cima"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3333

# Domínio do front. O navegador só deixa o site conversar com a API se a origem
# bater exatamente, então sem barra no final e com https.
WEB_ORIGIN="https://app.seudominio.com.br"
WEB_APP_URL="https://app.seudominio.com.br"

# ---------------------------------------------------------------------------
# Mídia
# ---------------------------------------------------------------------------
# Em produção o disco do servidor é apagado a cada publicação, então foto
# enviada sumiria no deploy seguinte. Por isso aqui é sempre bucket.
#
# Onde achar no Supabase: Project Settings, Storage, seção S3 Connection.
# Crie antes um bucket PRIVADO chamado nexlar-media.
STORAGE_DRIVER=s3
S3_ENDPOINT="https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="nexlar-media"
S3_ACCESS_KEY="gerado no painel, em S3 access keys"
S3_SECRET_KEY="mostrado uma vez so, guarde na hora"
MEDIA_MAX_PHOTO_MB=15
MEDIA_MAX_VIDEO_MB=200
MEDIA_MAX_PHOTOS_PER_PROPERTY=40
MEDIA_MAX_VIDEOS_PER_PROPERTY=5
